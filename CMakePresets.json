{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        }
      }
    },
    {
      "name": "linux-system",
      "displayName": "Linux (System Qt6)",
      "description": "Configure using system-installed Qt6 packages",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-x64-vcpkg",
      "displayName": "Linux x64 (vcpkg)",
      "description": "Configure using vcpkg dependencies for Linux x64",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "windows-x64-vcpkg",
      "displayName": "Windows x64 (vcpkg)",
      "description": "Configure using vcpkg dependencies for Windows x64",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "macos-arm64-vcpkg",
      "displayName": "macOS ARM64 (vcpkg)",
      "description": "Configure using vcpkg dependencies for macOS Apple Silicon",
      "inherits": "vcpkg-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-system",
      "configurePreset": "linux-system"
    },
    {
      "name": "linux-x64-vcpkg",
      "configurePreset": "linux-x64-vcpkg"
    },
    {
      "name": "windows-x64-vcpkg",
      "configurePreset": "windows-x64-vcpkg"
    },
    {
      "name": "macos-arm64-vcpkg",
      "configurePreset": "macos-arm64-vcpkg"
    }
  ],
  "testPresets": [
    {
      "name": "linux-system",
      "configurePreset": "linux-system",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x64-vcpkg",
      "configurePreset": "linux-x64-vcpkg",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
